# Repository-level .gitignore for blog-app

# Environment
.env
.env.local
.env.*.local

# Node / JS
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# PHP / Composer
/vendor/
composer.lock

# IDEs and editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Database files
*.sqlite
*.sqlite3
*.db

# Logs and temporary
logs/
*.log
tmp/
temp/

# User uploads
uploads/

# Secrets and keys
*.pem
*.key
*.crt
*.p12
*.pfx

# Build / distribution
dist/
build/

# Keep example env file
!.env.example
